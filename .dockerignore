# The build context is an allow-list: everything is excluded, then only what the image build needs is
# added back. A new file at the root (a local database, an .env file, a secret) never enters the context.
*

!global.json
!nuget.config
!Directory.Packages.props
!eng/ElPaqueto.Build.props
!src/

# Build outputs, local state and secrets inside src/ stay out.
**/bin/
**/obj/
**/TestResults/
**/.vs/
**/.vscode/
**/.idea/
**/*.user
**/*.db
**/*.db-shm
**/*.db-wal
**/.env*
**/secrets/
**/appsettings.*.local.json
