@using ElPaqueto.Web.Extensions
@using ElPaqueto.Web.Helper
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.Extensions.Options

@inject IOptions<StatisticsOptions> StatisticsOptions
@inject ApplicationVersion Version

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="ElPaqueto">
    <meta name="author" content="@Version.Authors">
    @Html.AddReleaseMetaTags()

    <link rel="icon" href="~/_content/ElPaqueto.Web/favicon.ico" sizes="16x16 32x32 48x48">
    <link rel="icon" type="image/png" href="~/_content/ElPaqueto.Web/images/elpaqueto-icon-32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="~/_content/ElPaqueto.Web/images/elpaqueto-icon-180.png">

    <link rel="stylesheet" href="~/_content/ElPaqueto.Web/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/_content/ElPaqueto.Web/lib/office-ui-fabric-core/dist/css/fabric.min.css" />
    <link rel="stylesheet" href="~/_content/ElPaqueto.Web/css/site.css" />

    <title>@ViewData["Title"] - ElPaqueto</title>
</head>
<body>
    <header>
        <nav class="navbar navbar-inverse" role="navigation">
            <div class="container">
                <div class="row">
                    <div id="navbar" class="col-sm-12">
                        <a class="elpaqueto-brand" asp-area="" asp-page="/Index">
                            <img src="~/_content/ElPaqueto.Web/images/elpaqueto-header-48.png"
                                 srcset="~/_content/ElPaqueto.Web/images/elpaqueto-header-96.png 2x"
                                 width="40" height="40" alt="" />
                            <span>ElPaqueto</span>
                        </a>
                        <ul class="nav navbar-nav" role="tablist">
                            <li role="presentation"><a asp-area="" asp-page="/Index" role="tab" nav-link><span>Packages</span></a></li>
                            <li role="presentation"><a asp-area="" asp-page="/Upload" role="tab" nav-link><span>Upload</span></a></li>
                            @if (StatisticsOptions.Value.EnableStatisticsPage)
                            {
                                <li role="presentation"><a asp-area="" asp-page="/Statistics" role="tab" nav-link><span>Statistics</span></a></li>
                            }
                            <li role="presentation">
                                <a role="tab" href="https://github.com/sputier/ElPaqueto/tree/develop/docs/user" target="_blank" rel="noopener noreferrer">
                                    <span>Documentation</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="container search-container">
                <div class="row">
                    <form class="col-sm-12" action="@Url.Page("/Index")" method="get">
                        <div class="input-group">
                            <input type="text"
                                   name="q"
                                   value="@ViewData["SearchQuery"]"
                                   class="form-control"
                                   autoComplete="off"
                                   placeholder="Search packages..." />

                            <span class="input-group-btn">
                                <button type="submit"
                                        class="btn btn-default"
                                        title="Search for packages">
                                    <span class="ms-Icon ms-Icon--Search" aria-hidden="true"></span>
                                </button>
                            </span>
                        </div>

                        @await RenderSectionAsync("SearchForm", required: false)
                    </form>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container main-container">
        @RenderBody()
    </main>

    <footer class="footer">
        <p>
            ElPaqueto @Version.Version
            &middot; <a href="https://github.com/sputier/ElPaqueto" target="_blank" rel="noopener noreferrer">Source code</a>
            &middot; Based on <a href="https://github.com/bagetter/BaGetter" target="_blank" rel="noopener noreferrer">BaGetter</a> (MIT)
        </p>
        @Html.AddReleaseInformationAsComment()
    </footer>

    <script src="~/_content/ElPaqueto.Web/lib/alpinejs/dist/alpine.js"></script>

    <script src="~/_content/ElPaqueto.Web/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/_content/ElPaqueto.Web/lib/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/_content/ElPaqueto.Web/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
