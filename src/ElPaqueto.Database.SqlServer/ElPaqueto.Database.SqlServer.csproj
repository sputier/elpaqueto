<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <PackageTags>NuGet</PackageTags>
    <Description>The libraries to host ElPaqueto on SQL Server.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Pinned directly (and, with central transitive pinning, for EF Core too) to control the driver version:
         EF Core SqlServer 10.0.x itself declares 6.1.x. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- SqlClient 7 no longer ships Microsoft Entra ID authentication; without this package, connection strings with
         `Authentication=Active Directory ...` fail at runtime. -->
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElPaqueto.Core\ElPaqueto.Core.csproj" />
  </ItemGroup>

</Project>
